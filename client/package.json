{
  "name": "remote-control-client",
  "version": "1.0.0",
  "description": "Cross-platform Remote Control Client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.zifang.remotecontrol",
    "productName": "RemoteControl",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "preload.js",
      "renderer.js",
      "styles.css",
      "icons/*"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "deb"
    }
  },
  "dependencies": {
    "ws": "^8.18.0",
    "@nut-tree/nut-js": "^3.1.0",
    "jpeg-js": "^0.4.4"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}