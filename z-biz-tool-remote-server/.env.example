# Server bind address (default: 0.0.0.0)
HOST=0.0.0.0

# Server port (default: 8080)
PORT=8080

# Auth token. Clients must present this as either:
#   - query param: ws://host:port/?token=<TOKEN>
#   - header: Authorization: Bearer <TOKEN>
# Generate one with: openssl rand -hex 32
AUTH_TOKEN=

# TLS / WSS — leave empty to serve plain ws://
# Provide both to serve wss://
TLS_KEY_PATH=
TLS_CERT_PATH=

# Optional: persist sessions to a JSON file (for visibility / monitoring).
# Leave empty for in-memory only.
SESSIONS_FILE=

# Optional: log level (debug|info|warn|error)
LOG_LEVEL=info
