# Server bind address (default: 0.0.0.0)
HOST=0.0.0.0

# Server port (default: 8080)
PORT=8080

# Auth token (legacy shared-token mode). Clients may present this as either:
#   - first frame: {"type":"AUTH","token":"<TOKEN>"}   (default, WS_TOKEN_TRANSPORT=frame)
#   - query param: ws://host:port/?token=<TOKEN>        (legacy compatibility only)
#   - header: Authorization: Bearer <TOKEN>             (non-browser clients)
# Generate one with: openssl rand -hex 32
AUTH_TOKEN=

# TLS / WSS — leave empty to serve plain ws://
# Provide BOTH to serve wss://. Only one of them is a hard startup failure
# (the server refuses to boot rather than silently falling back to plaintext).
TLS_KEY_PATH=
TLS_CERT_PATH=

# How the WS client presents its account token:
#   frame (default) — first frame {"type":"AUTH","token":"..."}; the URL carries no credentials
#   query           — legacy: ws://host/?token=... (only for old clients)
#   both            — accept either (rollout window)
WS_TOKEN_TRANSPORT=frame

# How long an unauthenticated socket may stay open waiting for its AUTH frame (ms)
WS_AUTH_TIMEOUT_MS=5000

# Registration gate.
#   REGISTER_RATE_LIMIT     — registration attempts allowed per IP per window (0 = off). Default 5
#   REGISTER_RATE_WINDOW_MS — window length in ms. Default 600000 (10 min)
#   INVITE_CODE             — when set, registration must carry a matching inviteCode
INVITE_CODE=
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW_MS=600000

# Optional: persist sessions to a JSON file (for visibility / monitoring).
# Leave empty for in-memory only.
SESSIONS_FILE=

# Optional: log level (debug|info|warn|error)
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────
# ctc 统一 SSO（**全部留空 = 未启用**）
# ─────────────────────────────────────────────────────────────
# 这几项**缺任何一项都算「未启用」** ⇒ 服务端的 GET /api/sso/config 返回 204，
# 客户端据此**不显示** SSO 登录入口（而不是显示一个点了必失败的按钮）。
# 账号密码登录在 SSO 开启/关闭时都照常可用 —— SSO 是多一种入口，不是替代。
#
#   SSO_AUTHORIZE_URL — ctc 授权页地址（OIDC/OAuth2 授权码流程）
#   SSO_TOKEN_URL     — ctc 令牌端点（服务端用 form-urlencoded 换 token）
#   SSO_USERINFO_URL  — ctc 用户信息端点。**服务端自己拿 token 去这里换身份**，
#                       不采信客户端上报的用户标识 —— 否则任何人都能冒充别人
#   SSO_CLIENT_ID     — 本产品在 ctc 注册的 client id
#   SSO_SCOPE         — 申请的权限范围，默认 openid profile email
#   SSO_TIMEOUT_MS    — 调 ctc 的超时（毫秒），默认 10000
#
# 客户端自己拼 redirect_uri（本地回环地址，端口由内核分配），**这里不要配**。
SSO_AUTHORIZE_URL=
SSO_TOKEN_URL=
SSO_USERINFO_URL=
SSO_CLIENT_ID=
SSO_SCOPE=openid profile email
SSO_TIMEOUT_MS=10000
